    // ============================================================
    // #OPERADORES
    // ============================================================
    // Comparar:  ==  !=  <  >  <=  >=      (= ASIGNA, == COMPARA)
    // Lógicos:   &&  (Y: las dos true)
    //            ||  (O: basta una true)
    //            !   (NO: le da la vuelta)
    // Resto:     %   -> n % 2 == 0 es par, n % 3 == 0 múltiplo de 3
    // Atajos:    x++  x--  x += 5  x -= 2  x *= 2  x /= 10
    static void operadores(int n) {
        boolean par = n % 2 == 0;
        boolean entre1y10 = n >= 1 && n <= 10;     // dentro del rango
        boolean fuera = n < 1 || n > 10;           // fuera del rango
        boolean ni16niMult3 = n != 16 && n % 3 != 0;
    }

    // ============================================================
    // #IF  (if / else if / else)
    // ============================================================
    // - Entra en la PRIMERA condición true y se salta el resto.
    // - EL ORDEN IMPORTA: en el 2º else if ya sé que nota >= 5.
    // - Pon SIEMPRE llaves { }.
    static void ejemploIf(int nota) {
        if (nota < 5) {
            System.out.println("Suspenso");
        } else if (nota < 7) {
            System.out.println("Aprobado");
        } else if (nota < 9) {
            System.out.println("Notable");
        } else {
            System.out.println("Sobresaliente");
        }

        // if anidado (un if dentro de otro)
        if (nota >= 5) {
            if (nota == 10) {
                System.out.println("Matrícula");
            }
        }
    }

    // ============================================================
    // #SWITCH  (compara un VALOR concreto, no sirve para rangos)
    // ============================================================
    // - Vale con int, char y String. NO con double ni boolean.
    // - Sin break SIGUE ejecutando los case de abajo.
    // - Varios case seguidos = comparten acciones.
    // - default = si no coincide ninguno (como el else).
    static void ejemploSwitch(int mes, String dia) {
        int dias;
        switch (mes) {
            case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                dias = 31;
                break;
            case 4: case 6: case 9: case 11:
                dias = 30;
                break;
            case 2:
                dias = 28;
                break;
            default:
                dias = -1;   // mes no válido
        }

        switch (dia) {                 // switch con String
            case "sábado":
            case "domingo":
                System.out.println("Finde");
                break;
            default:
                System.out.println("Entre semana");
        }
    }

    // ============================================================
    // #TERNARIO   condición ? valorSiTrue : valorSiFalse
    // ============================================================
    // Devuelve un VALOR. No sirve para ejecutar bloques de código.
    static void ejemploTernario(int a, int b, int nota) {
        int mayor = (a > b) ? a : b;
        String paridad = (a % 2 == 0) ? "par" : "impar";
        System.out.println(nota >= 5 ? "Aprobado" : "Suspenso");
    }

    // ============================================================
    // #WHILE   comprueba ANTES -> se puede ejecutar 0 veces
    // ============================================================
    // ¡Dentro tiene que cambiar algo de la condición o es infinito!
    static void ejemploWhile() {
        int segundos = 5;
        while (segundos > 0) {
            System.out.println(segundos + "...");
            segundos--;                     // <- sin esto, infinito
        }
        System.out.println("¡Despegue!");
    }

    // ============================================================
    // #DOWHILE   comprueba DESPUÉS -> se ejecuta MÍNIMO 1 vez
    // ============================================================
    // ¡Lleva ; después del while!
    static void ejemploDoWhile() {
        int i = 1;
        do {
            System.out.println(i);
            i++;
        } while (i <= 5);                   // <- ; obligatorio
    }

    // ============================================================
    // #FOR   cuando SÉ cuántas vueltas
    // ============================================================
    // for (inicialización ; condición ; incremento)
    //   inicialización -> 1 sola vez al principio
    //   condición      -> antes de cada vuelta
    //   incremento     -> después de cada vuelta
    // La i declarada en el for NO existe fuera del for.
    static void ejemploFor(int n) {
        for (int i = 1; i <= n; i++) {          // 1 2 3 ... n
            System.out.println(i);
        }
        for (int i = 10; i >= 0; i -= 2) {      // 10 8 6 4 2 0
            System.out.print(i + " ");
        }
        for (int i = 0; i <= 100; i += 5) {     // 0 5 10 ... 100
            System.out.print(i + " ");
        }
        System.out.println();

        // El mismo for escrito como while:
        int j = 1;
        while (j <= n) {
            System.out.println(j);
            j++;
        }
    }

