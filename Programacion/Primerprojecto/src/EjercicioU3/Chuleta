                    break;
                case 2:
                    System.out.print("a: "); int c = sc.nextInt();
                    System.out.print("b: "); int d = sc.nextInt();
                    System.out.println("Resta: " + (c - d));
                    break;
                case 3:
                    System.out.println("¡Adiós!");
                    break;
                default:
                    System.out.println("Opción incorrecta");
            }
        } while (opcion != 3);
    }

    // ============================================================
    // #CIFRAS   n % 10 = última cifra   |   n / 10 = la quita
    // ============================================================
    static void cifras(int numero) {
        int aux = numero;
        int suma = 0, cantidad = 0, reves = 0;

        while (aux > 0) {
            int cifra = aux % 10;
            suma += cifra;                  // suma de cifras
            cantidad++;                     // nº de cifras
            reves = reves * 10 + cifra;     // número al revés
            aux = aux / 10;
        }
        System.out.println(numero + " al revés es " + reves);
    }

