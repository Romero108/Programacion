    // ============================================================
    // #CENTINELA   leer números hasta un 0 (el 0 NO cuenta)
    // ============================================================
    // Truco: 1ª lectura ANTES del bucle, la siguiente al FINAL.
    static void centinela() {
        int suma = 0, cont = 0;

        System.out.print("Número (0 para terminar): ");
        int n = sc.nextInt();

        while (n != 0) {
            suma += n;
            cont++;
            System.out.print("Número (0 para terminar): ");
            n = sc.nextInt();
        }

        System.out.println("Has metido " + cont + " números");
        if (cont > 0) {
            System.out.println("Media: " + (double) suma / cont);
        }
    }

    // ============================================================
    // #FIN   repetir hasta que el usuario escriba "fin"
    // ============================================================
    static void hastaFin() {
        int contador = 0;

        System.out.print("Nombre (fin para salir): ");
        String nombre = sc.nextLine();

        while (!nombre.equals("fin")) {
            contador++;
            System.out.print("Nota: ");
            int nota = sc.nextInt();
            sc.nextLine();                         // <- limpiar tras nextInt

            System.out.print("Nombre (fin para salir): ");
            nombre = sc.nextLine();
        }
        System.out.println("Total: " + contador);
    }

